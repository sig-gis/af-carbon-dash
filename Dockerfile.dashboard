# Streamlit dashboard container (separate from API/Quarto container)
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1

# Install dependencies first for better layer caching
COPY ./pyproject.toml ./uv.lock ./.python-version /app/
RUN uv sync --locked --no-install-project

# Copy dashboard app code
COPY carbon_dash.py /app/
COPY pages/ /app/pages/
COPY utils/ /app/utils/
COPY conf/ /app/conf/

# Keep model_service code available because dashboard currently imports
# helpers from model_service.main (without running API in this container)
COPY model_service/ /app/model_service/

# Project source is picked up via PYTHONPATH. We don't install the package
# itself in the container (the `scenario` CLI is for local dev only).
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app

EXPOSE 8080

# Cloud Run supplies PORT; default to 8080 for local runs
CMD ["sh", "-c", "streamlit run carbon_dash.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true"]
